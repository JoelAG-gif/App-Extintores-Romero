<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FF5722"
        android:padding="16dp"
        android:elevation="4dp">

        <TextView
            android:id="@+id/tvWelcome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bienvenido, Cliente"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Panel de Cliente"
            android:textSize="14sp"
            android:textColor="@android:color/white"
            android:layout_marginTop="4dp"/>

        <TextView
            android:id="@+id/tvAlerta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚠️ Alerta de vencimiento"
            android:textSize="14sp"
            android:textColor="#FFEB3B"
            android:textStyle="bold"
            android:layout_marginTop="8dp"
            android:padding="8dp"
            android:background="#D84315"
            android:visibility="gone"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:weightSum="3">

        <Button
            android:id="@+id/btnAgregarExtintor"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Agregar\nExtintor"
            android:backgroundTint="#4CAF50"
            android:textColor="@android:color/white"
            android:layout_margin="4dp"
            android:minHeight="80dp"/>

        <Button
            android:id="@+id/btnMisExtintores"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Mis\nExtintores"
            android:backgroundTint="#2196F3"
            android:textColor="@android:color/white"
            android:layout_margin="4dp"
            android:minHeight="80dp"/>

        <Button
            android:id="@+id/btnSolicitarServicio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Solicitar\nServicio"
            android:backgroundTint="#FF9800"
            android:textColor="@android:color/white"
            android:layout_margin="4dp"
            android:minHeight="80dp"/>
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Mis Extintores Registrados"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#333"
        android:layout_margin="16dp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvExtintores"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp"/>

    <Button
        android:id="@+id/btnCerrarSesion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="CERRAR SESIÓN"
        android:backgroundTint="#F44336"
        android:textColor="@android:color/white"
        android:layout_margin="16dp"/>

</LinearLayout>